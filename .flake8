[flake8]
# 最大行长度（配合 Black）
max-line-length = 88

# 排除的文件/目录
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .pytest_cache,
    .mypy_cache,
    .tox

# 忽略的错误
ignore =
    # Black 兼容
    E203,  # whitespace before ':'
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator

# 最大复杂度
max-complexity = 10

# 排除特定错误
per-file-ignores =
    __init__.py: F401
